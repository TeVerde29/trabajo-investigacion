filters:
  and:
    - vence
    - estado != "hecha"
    - estado != "cancelada"
    - estado != "cerrada"
    - estado != "archivado"
    - estado != "completado"
formulas:
  dias_restantes: if(vence, (date(vence) - today()).days, "")
properties:
  formula.dias_restantes:
    displayName: Días
views:
  - type: table
    name: Próximos vencimientos
    order:
      - vence
      - formula.dias_restantes
      - file.name
      - proyecto
      - responsable
    sort:
      - property: vence
        direction: ASC
